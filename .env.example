# ─────────────────────────────────────────────────────────────────────────────
# DNA Email API — environment variable reference
# Copy this file to .env and fill in your values for local docker-compose runs.
# In Coolify, add these as Environment Variables in the UI (without the $ wrapping).
# ─────────────────────────────────────────────────────────────────────────────

ASPNETCORE_ENVIRONMENT=Production

# ── SMTP (server-level fallback — optional) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_DISPLAY_NAME=DNA Lab
SMTP_TIMEOUT_MS=30000

# ── API Keys ──────────────────────────────────────────────────────────────────
API_KEY_0_VALUE=change-me-generate-with-openssl-rand-hex-32
API_KEY_0_NAME=Default
API_KEY_0_RATE_LIMIT=100
API_KEY_0_WINDOW_SECONDS=60
API_KEY_0_QUEUE_LIMIT=0

API_KEY_1_VALUE=
API_KEY_1_NAME=
API_KEY_1_RATE_LIMIT=1000
API_KEY_1_WINDOW_SECONDS=60
API_KEY_1_QUEUE_LIMIT=10

# ── DKIM signing (optional) ───────────────────────────────────────────────────
DKIM_ENABLED=false
DKIM_DOMAIN=yourdomain.com
DKIM_SELECTOR=mail
DKIM_PRIVATE_KEY_PEM=

# ── S/MIME signing (optional) ─────────────────────────────────────────────────
SMIME_ENABLED=false
SMIME_CERT_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN_0=*

# ── Request limits ────────────────────────────────────────────────────────────
MAX_REQUEST_BYTES=52428800
