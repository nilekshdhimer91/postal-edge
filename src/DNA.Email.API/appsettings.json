{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DNA.Email": "Information"
    }
  },
  "AllowedHosts": "*",

  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "TimeoutMs": 30000,
    "DisplayName": ""
  },

  "Dkim": {
    "Enabled": false
  },

  "Smime": {
    "Enabled": false,
    "CertificatePath": "",
    "CertificatePassword": ""
  },

  "ApiKey": {
    "HeaderName": "X-Api-Key",
    "Keys": [
      {
        "Key": "dna-key-default-change-me-in-prod",
        "Name": "Default Key",
        "RateLimit": {
          "PermitLimit": 100,
          "WindowSeconds": 60,
          "QueueLimit": 0
        }
      },
      {
        "Key": "dna-key-highvolume-change-me-in-prod",
        "Name": "High Volume Key",
        "RateLimit": {
          "PermitLimit": 1000,
          "WindowSeconds": 60,
          "QueueLimit": 10
        }
      }
    ]
  },

  "Cors": {
    "AllowedOrigins": [ "*" ]
  },

  "Limits": {
    "MaxRequestBodyBytes": 52428800
  }
}
